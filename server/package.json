    "express": "5.2.1",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.6",
    "@types/node": "22.9.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
