{
  "name": "pixel-art",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "CFG=\"$PWD/mprocs.yaml\" && cd \"$(mktemp -d)\" && exec mprocs --config \"$CFG\"",
    "dev:client": "cd client && bun run dev",
    "dev:server": "cd server && bun run dev",
    "build": "cd client && bun run build",
    "typecheck": "bun run --cwd client typecheck && bun run --cwd server typecheck",
    "lint": "bun run --cwd client lint && bun run --cwd server lint",
    "lint:fix": "bun run --cwd client lint:fix && bun run --cwd server lint:fix",
    "test": "bun run --cwd client test",
    "coverage": "bun run --cwd client coverage",
    "storybook": "bun run --cwd client storybook",
    "storybook:dev": "bun run --cwd client storybook:dev",
    "build-storybook": "bun run --cwd client build-storybook",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build",
    "format": "bunx prettier --write \"*.{json,md,yaml,yml}\" \"client/*.{ts,js,json}\" \"server/*.{ts,js,json}\" \"client/src/types/**/*.{ts,tsx}\"",
    "format:check": "bunx prettier --check \"*.{json,md,yaml,yml}\" \"client/*.{ts,js,json}\" \"server/*.{ts,js,json}\" \"client/src/types/**/*.{ts,tsx}\"",
    "format:all": "bunx prettier --write .",
    "format:check:all": "bunx prettier --check .",
    "install:all": "bun install && cd client && bun install && cd ../server && bun install",
    "ai:setup": "cd ai-service && ./setup.sh",
    "ai:run": "cd ai-service && python server.py",
    "ai": "bun run ai:start",
    "ai:start": "bun run ai:setup && bun run ai:run"
  },
  "devDependencies": {
    "mprocs": "0.8.3",
    "prettier": "3.9.6"
  }
}
